code = "shader_type canvas_item;
render_mode blend_mix;

instance uniform vec4 MaskColor : source_color;
instance uniform float FloatParameter : hint_range(0.0010000000475, 0.00999999977648) = 0.0010000000475;
instance uniform vec4 GlowColor : source_color = vec4(1.297842, 1.297842, 1.297842, 1.000000);
instance uniform vec4 flash_color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
instance uniform float flash_value : hint_range(0.0, 1.0, 0.10000000149012) = 1.0;



void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;


// ColorParameter:4
	vec4 n_out4p0 = MaskColor;


// ColorOp:3
	vec3 n_out3p0 = abs(vec3(n_out2p0.xyz) - vec3(n_out4p0.xyz));


// FloatParameter:6
	float n_out6p0 = FloatParameter;


// Vector3Constant:15
	vec3 n_out15p0 = vec3(1.000000, 1.000000, 1.000000);


	vec3 n_out5p0;
// If:5
	float n_in5p1 = 0.00000;
	vec3 n_in5p4 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in5p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out3p0.x - n_in5p1) < n_out6p0)
	{
		n_out5p0 = n_out15p0;
	}
	else if(n_out3p0.x < n_in5p1)
	{
		n_out5p0 = n_in5p5;
	}
	else
	{
		n_out5p0 = n_in5p4;
	}


// ColorParameter:8
	vec4 n_out8p0 = GlowColor;


// Mix:20
	vec3 n_in20p0 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out20p0 = mix(n_in20p0, vec3(n_out2p0.xyz), vec3(n_out8p0.xyz));


	vec3 n_out7p0;
// Switch:7
	n_out7p0 = mix(vec3(n_out2p0.xyz), n_out20p0, float(all(bvec3(n_out5p0))));


// ColorParameter:11
	vec4 n_out11p0 = flash_color;


// FloatParameter:12
	float n_out12p0 = flash_value;


// Mix:13
	vec3 n_in13p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out13p0 = mix(vec3(n_out11p0.xyz), n_in13p1, vec3(n_out12p0));


// Mix:24
	vec3 n_in24p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out24p0 = mix(n_out7p0, n_in24p1, n_out13p0);


// Output:0
	COLOR.rgb = n_out24p0;


}
